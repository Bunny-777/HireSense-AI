# =======================================================
# ELEVENLABS (Required for live voice STT & TTS)
# Free account at https://elevenlabs.io (10k chars/mo free)
# =======================================================
ELEVENLABS_API_KEY=your_elevenlabs_key

# =======================================================
# LLM CONFIGURATION (Supports Groq or OpenAI)
# =======================================================
# --- For GROQ (Fastest & Free Tier available): ---
# Get key from: https://console.groq.com/keys
OPENAI_API_KEY=gsk_your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
FOLLOWUP_MODEL=llama-3.3-70b-versatile
# Alternative fast Groq models:
# FOLLOWUP_MODEL=llama-3.1-8b-instant

# --- For Standard OpenAI: ---
# OPENAI_API_KEY=sk-your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# FOLLOWUP_MODEL=gpt-4o-mini

# =======================================================
# OPTIONAL INTERVIEW SETTINGS
# =======================================================
INTERVIEW_TURNS=5
NO_TTS=false
JOB_DESCRIPTION=Software Engineer - requires strong problem-solving, system design, communication, and project delivery skills.
ELEVENLABS_STT_LANGUAGE=en
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_turbo_v2
ELEVENLABS_VOICE_ID=m5qndnI7u4OAdXhH0Mr5
